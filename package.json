{
  "name": "sina96-my-pi-setup",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "tsx --test extensions/*/test.ts extensions/*/test/*.test.ts",
    "check": "npm run test && git diff --check"
  },
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sina96/my-pi-setup.git"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/*/src/index.ts"
    ],
    "themes": [
      "./themes/*.json"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./extensions/token-optimizer/prompts/*.md"
    ]
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
